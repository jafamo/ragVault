# Copia este fichero a .env y ajusta los valores a tu entorno.
# .env NO se versiona (ver .gitignore) — no metas secretos reales aquí.

###> ollama ###
# URL del servicio Ollama externo. Puede ser el mismo host (host.docker.internal
# desde dentro de un contenedor) u otra máquina de tu LAN.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
###< ollama ###

# URL a la que el NAVEGADOR del usuario debe llamar para llegar al backend.
# "localhost" solo funciona si accedes desde la misma máquina que ejecuta
# docker compose — si accedes desde otro equipo de la LAN, pon aquí la IP
# o el hostname del host Docker (p. ej. http://192.168.4.200:8000).
VITE_API_URL=http://localhost:8000

# Nivel de log (ver CLAUDE.md "Logging (compatible con ELK)")
LOG_LEVEL=INFO
